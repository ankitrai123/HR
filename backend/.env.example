# Copy to backend/.env and fill in. Real environment variables take precedence.
APP_ENV=development

# Claude (premium reports). Leave unset to run with pre-written fallbacks only.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium

# Security - REQUIRED when APP_ENV=production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESPONSE_ENCRYPTION_KEY=
ADMIN_API_KEY=

# Defaults to SQLite at data/assessments.db. For production use e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host/db  (pip install "psycopg[binary]")
CORS_ORIGINS=http://localhost:5173
ASSESSMENT_SCALE_POINTS=6

# Or use another provider (the admin dashboard can also set this, and overrides it):
# LLM_PROVIDER=nvidia            # anthropic | nvidia | openai | google | groq | mistral | deepseek |
#                                # together | openrouter | fireworks | xai | perplexity | ollama | custom
# LLM_API_KEY=nvapi-...
# LLM_MODEL=meta/llama-3.3-70b-instruct
# LLM_BASE_URL=                  # only for ollama / custom
