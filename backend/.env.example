# Copy to backend/.env and fill in. Real environment variables take precedence.
APP_ENV=development

# Claude (premium reports). Leave unset to run with pre-written fallbacks only.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium

# Security. RESPONSE_ENCRYPTION_KEY is REQUIRED when APP_ENV=production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESPONSE_ENCRYPTION_KEY=
# First admin from the browser in production (or run: python manage.py create-admin)
ADMIN_SETUP_TOKEN=
# Optional: lets scripts call admin endpoints with the X-API-Key header
ADMIN_API_KEY=

# Platform
PUBLIC_BASE_URL=http://localhost:8000
ORGANIZATION_NAME=Acme Corporation
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=+91 80 0000 0000
INVITATION_DEFAULT_DAYS=14

# Defaults to SQLite at data/assessments.db. For production use e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host/db  (pip install "psycopg[binary]")
CORS_ORIGINS=http://localhost:5173
ASSESSMENT_SCALE_POINTS=6

# Or use another provider (the admin dashboard can also set this, and overrides it):
# LLM_PROVIDER=nvidia            # anthropic | nvidia | openai | google | groq | mistral | deepseek |
#                                # together | openrouter | fireworks | xai | perplexity | ollama | custom
# LLM_API_KEY=nvapi-...
# LLM_MODEL=meta/llama-3.3-70b-instruct
# LLM_BASE_URL=                  # only for ollama / custom
